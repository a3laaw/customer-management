# قاعدة البيانات (محليًا: SQLite / للإنتاج: Supabase PostgreSQL)
DATABASE_URL="file:./db/custom.db"

# NextAuth secret (شغّل: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here-at-least-32-chars-long"

# رابط التطبيق (محلي: http://localhost:3000 / للإنتاج: https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
